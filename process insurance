# Per-snapshot period preference (first match wins; '' = column w/o period tag).
# Designation/SVO/Schedule only exist as 2025Q4 & 2026Q1 in this pull:
# 2025Q4 = YE2025 statutory filing -> used for BOTH snapshots (see header note).
PERIOD_PREF = {
    2025: {
        'Carrying_Value':      ['2025y'],
        'Fair_Value_per_Unit': ['2025y', ''],   # 2nd FV/unit col has no period tag
        'NAIC_Designation':    ['2025y', '2025q4'],
        'NAIC_Modifier':       ['2025y', '2025q4'],
        'SVO_Symbol':          ['2025y', '2025q4'],
        'NAIC_Schedule':       ['2025y', '2025q4'],
        'Collateral_Type':     ['2025y'],
        'PIK_Interest':        ['2025y'],
        'Deferred_Interest':   ['2025y'],
        'Conditional_FV':      ['2025q4', '2025y'],
    },
}
# Latest-quarter designation/SVO kept on every row for migration analysis
LATEST_PERIODS = ['2026q1']
LATEST_FIELDS = ['NAIC_Designation', 'NAIC_Modifier', 'SVO_Symbol']
# $000-denominated period fields (convert to $)
THOUSANDS_FIELDS = {'Carrying_Value', 'PIK_Interest', 'Deferred_Interest',
                    'Conditional_FV'}

SVO_BUCKET_SORT = {'PL': 1, 'No Symbol': 2, 'FE': 3, 'Other': 4}
NAIC_BUCKET_SORT = {'NAIC 1': 1, 'NAIC 2': 2, 'NAIC 3-6': 3, 'Not Designated': 4}

RATING_ORDER = {
    'AAA': 1, 'AA+': 2, 'AA': 3, 'AA-': 4,
    'A+': 5, 'A': 6, 'A-': 7,
    'BBB+': 8, 'BBB': 9, 'BBB-': 10,
    'BB+': 11, 'BB': 12, 'BB-': 13,
    'B+': 14, 'B': 15, 'B-': 16,
    'CCC+': 17, 'CCC': 18, 'CCC-': 19,
    'CC': 20, 'C': 21, 'D': 22,
}

PERIOD_RX = re.compile(r'(20\d{2})\s*(y|q[1-4])\b', re.IGNORECASE)


# --- HELPERS -----------------------------------------------------------
def norm(s):
    """Normalize: collapse all whitespace (incl. line breaks), lowercase."""
    return re.sub(r'\s+', ' ', str(s)).strip().lower()


def cell(v):
    return '' if pd.isna(v) else str(v).strip()


def period_token(text):
    """'Carrying Value ($000) [2025 Q4]' -> '2025q4'; '' if none.
    Also handles CapIQ's MM/YY form: '[03/26 Q]' -> '2026q1'."""
    t = norm(text)
    m = PERIOD_RX.search(t)
    if m:
        return (m.group(1) + m.group(2)).lower()
    m = re.search(r'\b(\d{2})/(\d{2})\s*q\b', t)
    if m:
        month, yy = int(m.group(1)), int(m.group(2))
        return f'20{yy:02d}q{(month - 1) // 3 + 1}'
    return ''


def build_headers(raw, max_scan=10):
    """Handle the 4-row SNLTable header block:
    main header row (merged cells) / optional blank row / ID row / period row.
    Returns (headers list, data_start_index)."""
    hdr = None
    for i in range(min(max_scan, len(raw))):
        if any(norm(c) == 'entity name' for c in raw.iloc[i].tolist()):
            hdr = i
            break
    if hdr is None:
        raise ValueError("No header row containing 'Entity Name' found in "
                         f"first {max_scan} rows - check SHEET_NAME.")

    main = [cell(c) for c in raw.iloc[hdr].tolist()]
    # forward-fill merged main-header cells
    for j in range(1, len(main)):
        if not main[j]:
            main[j] = main[j - 1]

    periods = [''] * len(main)
    data_start = hdr + 1
    for i in range(hdr + 1, min(hdr + 5, len(raw))):
        row = [cell(c) for c in raw.iloc[i].tolist()]
        nonempty = [c for c in row if c]
        if not nonempty:                                   # blank (merged) row
            data_start = i + 1
            continue
        n_num = sum(bool(re.fullmatch(r'\d+(\.0)?', c)) for c in nonempty)
        n_per = sum(bool(PERIOD_RX.fullmatch(re.sub(r'\s+', '', c))) for c in nonempty)
        if n_per >= 2 and n_per >= len(nonempty) * 0.5:    # period row
            periods = [re.sub(r'\s+', '', c).lower()
                       if PERIOD_RX.fullmatch(re.sub(r'\s+', '', c)) else ''
                       for c in row]
            data_start = i + 1
        elif n_num >= len(nonempty) * 0.5:                 # field-ID row
            data_start = i + 1
        else:                                              # first data row
            break

    headers = [f'{m} [{p}]' if p else m for m, p in zip(main, periods)]
    # de-duplicate
    seen, out = {}, []
    for h in headers:
        if h in seen:
            seen[h] += 1
            out.append(f'{h}_{seen[h]}')
        else:
            seen[h] = 0
            out.append(h)
    return out, data_start


def naic_bucket(x):
    if pd.isna(x):
        return 'Not Designated'
    m = re.search(r'[1-6]', str(x))
    if not m:
        return 'Not Designated'
    d = int(m.group())
    return f'NAIC {d}' if d <= 2 else 'NAIC 3-6'


def svo_bucket(x):
    """PL = private letter rating (core PC); FE = filing exempt (public rating);
    No Symbol = blank -> designation via SVO review (traditional PP, no symbol);
    Other = admin states (Z/YE/IF/GI/*...)."""
    if pd.isna(x) or not str(x).strip():
        return 'No Symbol'
    s = str(x).strip().upper()
    if s in ('NAN', 'NONE', 'NA'):
        return 'No Symbol'
    if s.startswith('PL'):
        return 'PL'
    if s.startswith('FE'):
        return 'FE'
    return 'Other'


# --- MAIN --------------------------------------------------------------
def process_insurance_data(input_file=INPUT_FILE, sheet_name=SHEET_NAME,
                           entity_file=ENTITY_FILE, output_file=OUTPUT_FILE):
    print(f"Reading {input_file} (sheet: {sheet_name})...")
    raw = pd.read_excel(input_file, sheet_name=sheet_name, header=None)

    headers, data_start = build_headers(raw)
    df = raw.iloc[data_start:].reset_index(drop=True)
    df.columns = headers
    df = df.dropna(how='all')
    audit = {'0_Initial_Holdings_Rows': len(df)}
    print(f"[INFO] Data starts at sheet row {data_start + 1}; {len(df)} rows")

    # 1. Resolve static columns
    cols = list(df.columns)
    def find_static(pat):
        rx = re.compile(pat)
        hits = [c for c in cols if rx.search(norm(c)) and not period_token(c)]
        if not hits:  # allow period-tagged fallback (e.g. merged oddities)
            hits = [c for c in cols if rx.search(norm(c))]
        return hits[0] if hits else None

    static_cols = {}
    for name, pat in STATIC_PATTERNS.items():
        c = find_static(pat)
        if c is None:
            print(f"[WARN] Static column not found: {name}")
        else:
            static_cols[name] = c
    for required in ('Entity Name', 'Company Investment Key'):
        if required not in static_cols:
            raise KeyError(f"Required column missing: {required}. "
                           f"All columns:\n{cols}")

    # 2. Resolve period-bearing columns: field -> {period_token: column}
    field_cols = {}
    for name, base_pat in FIELD_BASE.items():
        rx = re.compile(base_pat)
        field_cols[name] = {}
        for c in cols:
            if rx.search(norm(c)):
                field_cols[name][period_token(c)] = c
        if not field_cols[name]:
            print(f"[WARN] No column found for field: {name}")
        else:
            print(f"[INFO] {name}: {field_cols[name]}")

    def pick(name, prefs):
        for p in prefs:
            if p in field_cols.get(name, {}):
                return field_cols[name][p], p
        return None, None

    years = []
    for y in SNAPSHOT_YEARS:
        c, _ = pick('Carrying_Value', PERIOD_PREF[y]['Carrying_Value'])
        if c is None:
            print(f"[WARN] No Carrying Value column for {y} -> snapshot skipped "
                  f"(expected if the pull was trimmed to a single year)")
        else:
            years.append(y)
    if not years:
        raise KeyError(
            f"No Carrying Value column found for any of {SNAPSHOT_YEARS}. "
            f"Periods found: {sorted(field_cols.get('Carrying_Value', {}))}. "
            f"All columns:\n{cols}")

    # 3. Dedup on Company Investment Key
    key = static_cols['Company Investment Key']
    n_dup = df.duplicated(subset=[key]).sum()
    if n_dup:
        print(f"[WARN] {n_dup} duplicated Company Investment Key rows -> keep first")
        df = df.drop_duplicates(subset=[key], keep='first')
    audit['1_After_Key_Dedup'] = len(df)

    # 4. Long format: one row per holding x snapshot year
    long_frames = []
    for y in years:
        cv_col, _ = pick('Carrying_Value', PERIOD_PREF[y]['Carrying_Value'])
        cv = pd.to_numeric(df[cv_col], errors='coerce')
        held = cv.notna()
        sub = df[held]
        part = pd.DataFrame({'Snapshot_Year': y,
                             'Carrying_Value': cv[held] * 1000.0})
        for out_name, col in static_cols.items():
            if out_name != 'Private Placement':
                part[out_name] = sub[col].values
        for fname, prefs in PERIOD_PREF[y].items():
            if fname == 'Carrying_Value':
                continue
            c, p = pick(fname, prefs)
            if c is None:
                continue
            vals = sub[c]
            if fname in THOUSANDS_FIELDS:
                vals = pd.to_numeric(vals, errors='coerce') * 1000.0
            out = {'NAIC_Designation': 'NAIC_Designation_Raw',
                   'SVO_Symbol': 'SVO_Symbol_Raw'}.get(fname, fname)
            part[out] = vals.values
            if fname in ('NAIC_Designation', 'SVO_Symbol') and p and p != f'{y}y':
                print(f"[INFO] {y} snapshot: {fname} taken from period '{p}' "
                      f"(no {y}-period column in pull)")
        # latest-quarter designation/SVO for migration view
        for fname in LATEST_FIELDS:
            c, p = pick(fname, LATEST_PERIODS)
            if c is not None:
                part[f'{fname}_Latest'] = sub[c].values
        long_frames.append(part)
        print(f"[INFO] {y}: {int(held.sum())} holdings, "
              f"BACV total = ${part['Carrying_Value'].sum() / 1e9:,.2f}bn")

    fact = pd.concat(long_frames, ignore_index=True)

    # 4b. CUSIP type: chars *, @, # are reserved for PPNs and invalid in
    # standard CUSIPs -> any occurrence = PPN. Position tells the flavor:
    # pos 6 = PPN-assigned issuer; pos 7-8 = private issue of a CUSIP'd issuer.
    if 'CUSIP' in fact.columns:
        cu = fact['CUSIP'].astype(str).str.strip()
        has_special = cu.str.contains(r'[\*@#]', regex=True, na=False)
        pos6 = cu.str[5:6].isin(['*', '@', '#'])
        fact['CUSIP_Type'] = np.select(
            [cu.isin(['nan', '', 'None']),
             has_special & pos6,
             has_special],
            ['Missing', 'PPN (issuer-level)', 'PPN (issue-level)'],
            default='Standard')
        vc = fact['CUSIP_Type'].value_counts().to_dict()
        print(f"[INFO] CUSIP types: {vc}")
        if vc.get('Standard'):
            print(f"[WARN] {vc['Standard']} rows have standard CUSIPs (no PPN "
                  f"special char) despite Private Placement = Yes -> inspect")

    # 5. Buckets + sort keys
    nd = fact['NAIC_Designation_Raw'] if 'NAIC_Designation_Raw' in fact else pd.Series(np.nan, index=fact.index)
    sv = fact['SVO_Symbol_Raw'] if 'SVO_Symbol_Raw' in fact else pd.Series(np.nan, index=fact.index)
    fact['NAIC_Bucket'] = nd.map(naic_bucket)
    fact['NAIC_Sort'] = fact['NAIC_Bucket'].map(NAIC_BUCKET_SORT)
    fact['SVO_Bucket'] = sv.map(svo_bucket)
    fact['SVO_Sort'] = fact['SVO_Bucket'].map(SVO_BUCKET_SORT)
    if 'NAIC_Designation_Latest' in fact.columns:
        fact['NAIC_Bucket_Latest'] = fact['NAIC_Designation_Latest'].map(naic_bucket)
    if 'SVO_Symbol_Latest' in fact.columns:
        fact['SVO_Bucket_Latest'] = fact['SVO_Symbol_Latest'].map(svo_bucket)

    # 6. Integrity checks
    if 'SVO_Symbol_Raw' in fact.columns:
        other_syms = (fact.loc[fact['SVO_Bucket'] == 'Other', 'SVO_Symbol_Raw']
                      .dropna().astype(str).str.strip().str.upper())
        known_other = {'YE', 'GI', 'Z', 'ZE', 'IF', 'F', 'AM', 'RTS', 'RT',
                       'ND', 'NR', 'SYE', '*'}
        unknown = sorted(set(s for s in other_syms.unique()
                             if s and not any(s.startswith(k) for k in known_other)))
        if unknown:
            print(f"[WARN] SVO symbols in 'Other' not in known list: {unknown[:20]}")
    if 'NAIC_Designation_Raw' in fact.columns:
        odd = fact[(fact['NAIC_Bucket'] == 'Not Designated')
                   & fact['NAIC_Designation_Raw'].notna()]
        if len(odd):
            print(f"[WARN] {len(odd)} rows: NAIC Designation unparseable to 1-6: "
                  f"{list(odd['NAIC_Designation_Raw'].astype(str).unique()[:10])}")
    if 'NAIC_Schedule' in fact.columns:
        if fact['NAIC_Schedule'].isna().all():
            print("[INFO] NAIC Schedule column is empty (CapIQ doesn't backfill "
                  "fields used as screen criteria) -> schedule check skipped")
        else:
            sched = fact['NAIC_Schedule'].astype(str)
            n_not_d = (~sched.str.contains('D', case=False, na=False)).sum()
            if n_not_d:
                print(f"[WARN] {n_not_d}/{len(fact)} rows not Schedule D. "
                      f"Actual values (top 5): "
                      f"{fact['NAIC_Schedule'].value_counts(dropna=False).head().to_dict()}")
    if 'CUSIP_Type' in fact.columns and 'SVO_Bucket' in fact.columns:
        f25 = fact[fact['Snapshot_Year'] == SNAPSHOT_YEARS[-1]]
        ct = pd.crosstab(f25['CUSIP_Type'], f25['SVO_Bucket'],
                         values=f25['Carrying_Value'], aggfunc='sum').fillna(0) / 1e9
        print(f"[CHECK] CUSIP type x SVO bucket, {SNAPSHOT_YEARS[-1]} BACV $bn "
              f"(expect all PPN; any Standard row = non-PPN, inspect):")
        print(ct.round(1).to_string())

    n_neg = (fact['Carrying_Value'] < 0).sum()
    if n_neg:
        print(f"[WARN] {n_neg} rows with negative Carrying Value "
              f"-> exported to Audit_Negative_BACV.xlsx")
        fact[fact['Carrying_Value'] < 0].to_excel('Audit_Negative_BACV.xlsx',
                                                  index=False)
    if 'Conditional_FV' in fact.columns:
        f25 = fact[fact['Snapshot_Year'] == 2025]
        both = f25.dropna(subset=['Conditional_FV'])
        if len(both):
            ratio = (both['Conditional_FV'] / both['Carrying_Value']).replace(
                [np.inf, -np.inf], np.nan).dropna()
            print(f"[CHECK] 2025 FV/BACV: median {ratio.median():.3f} "
                  f"({len(both)} rows with FV) - expect ~0.9-1.0")

    audit['2_Fact_Rows_Total'] = len(fact)
    for y in years:
        audit[f'3_Fact_Rows_{y}'] = int((fact['Snapshot_Year'] == y).sum())
    audit['4_Entities'] = fact['Entity Name'].nunique()

    # 7. Dim_Entity
    dim = (fact.groupby('Entity Name', as_index=False)
           .agg(Holdings_Count=('Company Investment Key', 'nunique')))
    for col in ['SNL Group Name', 'Ultimate Parent', 'NAIC Company Code',
                'S&P Credit Rating', 'Total Cash & Invested Assets 2024',
                'Total Cash & Invested Assets 2025',
                'Capital & Surplus 2024', 'Capital & Surplus 2025']:
        dim[col] = np.nan

    # entity(owner)-level fields repeated on holding rows -> aggregate into Dim
    ent_name_col = static_cols['Entity Name']
    for fname, (out_name, prefs, kind) in ENTITY_LEVEL_FIELDS.items():
        c, _ = pick(fname, prefs)
        if c is None:
            continue
        if kind == 'str':
            vals = (df[c].astype(str).str.strip()
                    .replace({'nan': np.nan, 'None': np.nan, '': np.nan,
                              'NA': np.nan}))
            grp = (pd.DataFrame({'Entity Name': df[ent_name_col],
                                 out_name: vals})
                   .dropna().groupby('Entity Name')[out_name])
            agg = grp.first()
        else:
            vals = pd.to_numeric(df[c], errors='coerce')
            if kind == 'num_k':
                vals = vals * 1000.0
            grp = (pd.DataFrame({'Entity Name': df[ent_name_col],
                                 out_name: vals})
                   .dropna().groupby('Entity Name')[out_name])
            agg = grp.max()
        n_multi = int((grp.nunique() > 1).sum())
        if n_multi:
            print(f"[WARN] {out_name}: {n_multi} entities have >1 distinct "
                  f"value on holding rows (took "
                  f"{'first' if kind == 'str' else 'max'})")
        if out_name in dim.columns:   # replace placeholder column
            dim = dim.drop(columns=[out_name])
        dim = dim.merge(agg, left_on='Entity Name', right_index=True, how='left')
        print(f"[INFO] Dim_Entity <- {out_name} "
              f"({agg.notna().sum()}/{len(dim)} entities)")

    if entity_file and os.path.exists(entity_file):
        print(f"[INFO] Joining entity-level file: {entity_file}")
        ent_raw = pd.read_excel(entity_file, header=None)
        eheaders, estart = build_headers(ent_raw)
        ent = ent_raw.iloc[estart:].reset_index(drop=True)
        ent.columns = eheaders
        ent = ent.dropna(how='all')
        emap = {
            'SNL Group Name': r'snl group name',
            'Ultimate Parent': r'ultimate parent(?! ticker)',
            'NAIC Company Code': r'naic company code',
            'S&P Credit Rating': r's&p credit rating|s&p.*(fsr|icr)',
            'Total Cash & Invested Assets 2024': r'total cash.*invested assets.*2024',
            'Total Cash & Invested Assets 2025': r'total cash.*invested assets.*2025',
            'Capital & Surplus 2024': r'capital (&|and) surplus.*2024',
            'Capital & Surplus 2025': r'capital (&|and) surplus.*2025',
        }
        ename = next((c for c in ent.columns if norm(c).startswith('entity name')), None)
        if ename is None:
            print("[WARN] Entity file has no 'Entity Name' column; skipping join")
        else:
            keep = {ename: 'Entity Name'}
            for out, pat in emap.items():
                rx = re.compile(pat)
                c = next((c for c in ent.columns if rx.search(norm(c))), None)
                if c is not None:
                    keep[c] = out
                else:
                    print(f"[WARN] Entity file missing: {out}")
            ent_small = ent[list(keep)].rename(columns=keep)
            ent_small = ent_small.drop_duplicates(subset=['Entity Name'])
            for c in ent_small.columns:
                if 'Assets' in c or 'Surplus' in c:
                    ent_small[c] = pd.to_numeric(ent_small[c], errors='coerce') * 1000.0
            dim = dim.drop(columns=[c for c in keep.values()
                                    if c != 'Entity Name' and c in dim.columns])
            dim = dim.merge(ent_small, on='Entity Name', how='left')
            if 'SNL Group Name' in dim:
                n_un = dim['SNL Group Name'].isna().sum()
                if n_un:
                    print(f"[WARN] {n_un} entities unmatched in entity file")
    else:
        print(f"[INFO] Entity-level file not found ({entity_file}) -> "
              f"Dim_Entity placeholders only; % of portfolio blank until provided.")

    if 'S&P Credit Rating' in dim.columns:
        dim['Rating_Sort'] = (dim['S&P Credit Rating'].astype(str).str.strip()
                              .map(lambda x: RATING_ORDER.get(x, 99)))

    # 8. Export
    with pd.ExcelWriter(output_file, engine='openpyxl') as xw:
        fact.to_excel(xw, sheet_name='Fact_Holdings', index=False)
        dim.to_excel(xw, sheet_name='Dim_Entity', index=False)

    print("\n" + "=" * 44)
    print("        DATA PROCESSING AUDIT LOG")
    print("=" * 44)
    for step, count in audit.items():
        print(f"{step:<32} | {count:<10}")
    print("=" * 44)
    for y in years:
        fy = fact[fact['Snapshot_Year'] == y]
        tot = fy['Carrying_Value'].sum()
        if tot:
            pl = fy.loc[fy['SVO_Bucket'] == 'PL', 'Carrying_Value'].sum()
            ns = fy.loc[fy['SVO_Bucket'] == 'No Symbol', 'Carrying_Value'].sum()
            n1 = fy.loc[fy['NAIC_Bucket'] == 'NAIC 1', 'Carrying_Value'].sum()
            print(f"{y}: PP BACV ${tot/1e9:,.1f}bn | PL {pl/tot:.1%} | "
                  f"No Symbol {ns/tot:.1%} | NAIC 1 {n1/tot:.1%}")
    print(f"[NOTE] Universe = holdings on NAIC Schedule D Part 1 as of "
          f"{UNIVERSE_AS_OF}.")
    if not UNIVERSE_AS_OF.upper().endswith('Y'):
        print("       Quarterly-selected universe: snapshots before that date"
              "\n       only contain positions still held then (survivorship"
              "\n       bias) -> totals understate true exposure at snapshot"
              "\n       dates. Re-pull with criterion period = snapshot year"
              "\n       (e.g. 2025Y) to eliminate this.")
    elif UNIVERSE_AS_OF[:4] != str(max(years)):
        print(f"       [WARN] Universe date {UNIVERSE_AS_OF} != latest snapshot "
              f"{max(years)} -> check alignment.")
    else:
        print("       Universe date matches snapshot date -> no survivorship "
              "bias.")
    print(f"SUCCESS! File: {output_file}\n")
    return fact, dim


